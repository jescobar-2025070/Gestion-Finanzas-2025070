# ============================================================
# Configuración del backend - EJEMPLO (no usar secretos reales)
# Copia este archivo a .env y completa los valores.
# ============================================================

# Entorno: development | test | production
NODE_ENV=development

# Puerto HTTP del backend
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/finanzas_dev

# Secreto para firmar los JWT (genera uno fuerte, p.ej. con: openssl rand -hex 64)
JWT_SECRET=reemplazar-con-un-secreto-fuerte-de-al-menos-32-caracteres

# Duración del JWT (formato de jsonwebtoken: 1h, 15m, 7d)
JWT_EXPIRES_IN=1h

# Nombre de la cookie HttpOnly que transporta el JWT
COOKIE_NAME=finanzas_auth

# Cookie segura (solo HTTPS). TRUE en producción, FALSE en desarrollo local
COOKIE_SECURE=false

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:4200

# Coste del hash de contraseñas (bcrypt)
BCRYPT_ROUNDS=12

# Credenciales del usuario administrador inicial (solo para el script de seed)
ADMIN_EMAIL=admin@finanzas.local
ADMIN_PASSWORD=cambiar-esto-en-el-seed
